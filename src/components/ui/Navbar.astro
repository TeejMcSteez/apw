---
---

<nav id="nav">
    <a href="/" id="site-name">
        Tommy Hall
    </a>
    <a href="/services/" id="services-link">
        Services
    </a>
</nav>

<script is:inline>
    if (window.location.pathname != "/") {
        const el = document.getElementById("site-name");
        const original = el.innerText;
        const target = "Back";
        let i = original.length;

        const del = setInterval(() => {
            el.innerText = original.slice(0, i--);

            if (i < 0) {
                clearInterval(del);
                let j = 0;
                const type = setInterval(() => {
                    el.innerText = target.slice(0, ++j);
                    if (j >= target.length) clearInterval(type);
                }, 80);
            }
        }, 50);
    }
    // On server return path is /services/ breaking the strict match
    // Could use regex but this is simpler
    if (
        window.location.pathname == "/services" ||
        window.location.pathname == "/services/"
    ) {
        document.getElementById("services-link").style.display = "none";
    } else {
        document.getElementById("services-link").style.display = "flex";
    }
</script>

<style>
    #nav {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 1.75rem;
        border-bottom: 1px solid rgba(128, 128, 128, 0.15);
    }
    #site-name {
        font-size: 1.5rem;
        font-weight: bold;
        text-decoration: none;
        color: #292524;
        letter-spacing: 0.02em;
        transition: var(--button-animation-transition);
        line-height: 1;
        min-height: 1.5rem;
    }
    #site-name:hover {
        opacity: 0.6;
    }

    #services-link {
        text-decoration: none;
        text-align: end;
        color: black;
        font-size: large;
        background-color: oklch(45.5% 0.188 13.697);
        border-radius: 5px;
        padding: 10px;
    }

    #services-link:hover {
        opacity: 0.6;
    }
    @media (prefers-color-scheme: dark) {
        #site-name {
            color: white;
        }

        #services-link {
            color: white;
        }
    }
</style>
