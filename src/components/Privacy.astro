---
import Layout from "../layouts/Layout.astro";
import Navbar from "./ui/Navbar.astro";
---

<Layout>
    <Navbar />
    <h1 class="privacy-text">Privacy Notice</h1>
    <p class="privacy-text">
        This site uses a cookie to track the number of times a user has returned
        home to change the sub-text animation in the about sub-text.
        <br /> This website also uses <a href="https://posthog.com/">
            Posthog
        </a>{" "}
        for website analytics, therefore, any cookies they use will also be
        contained in this site.
    </p>
</Layout>

<style>
    .privacy-text {
        margin-top: 1rem;
        padding-top: 1rem;
        padding-left: 1rem;
    }

    .privacy-text a {
        text-align: center;
        text-decoration: none;
        color: white;
        text-decoration: underline;
    }
    .privacy-text a:hover {
        color: #0000ff;
    }
    @media (prefers-color-scheme: light) {
        .privacy-text a {
            color: black;
        }
    }
</style>
