---
import Layout from "../../layouts/Layout.astro";
const services = [
    {
        name: "Home Assistant",
        link: "https://www.home-assistant.io/",
    },
    {
        name: "Headscale",
        link: "https://headscale.net/stable/",
    },
    {
        name: "Debian Samba VM",
        link: "https://wiki.debian.org/Samba/ServerSimple",
    },
    {
        name: "NGINX",
        link: "https://nginx.org/",
    },
    {
        name: "Fail2ban",
        link: "https://github.com/fail2ban/fail2ban",
    },
    {
        name: "AdGuard Home",
        link: "https://github.com/AdguardTeam/AdGuardHome",
    },
    {
        name: "Frigate",
        link: "https://frigate.video/",
    },
    {
        name: "GoUp",
        link: "https://github.com/TeejMcSteez/goUp",
    },
    {
        name: "Jellyfin",
        link: "https://jellyfin.org/",
    },
    {
        name: "Jellyseer",
        link: "https://docs.seerr.dev/",
    },
    {
        name: "Prowlarr",
        link: "https://prowlarr.com/",
    },
    {
        name: "Radarr",
        link: "https://radarr.video/",
    },
    {
        name: "Sonarr",
        link: "https://sonarr.tv/",
    },
    {
        name: "qBittorrent",
        link: "https://www.qbittorrent.org/",
    },
    {
        name: "Minecraft ATM11 Server",
        link: "https://www.curseforge.com/minecraft/modpacks/all-the-mods-11",
    },
    {
        name: "Node-RED",
        link: "https://nodered.org/",
    },
    {
        name: "Grafana",
        link: "https://grafana.com/",
    },
    {
        name: "Tempo",
        link: "https://grafana.com/docs/tempo/latest/",
    },
    {
        name: "Mimir",
        link: "https://grafana.com/oss/mimir/",
    },
    {
        name: "Loki",
        link: "https://github.com/grafana/loki",
    },
    {
        name: "Otel-Collector",
        link: "https://opentelemetry.io/",
    },
    {
        name: "CVAT",
        link: "https://www.cvat.ai/",
    },
];
---

<Layout>
    <div class="homelab-container">
        <div id="homelab">
            <h1 class="homelab-title">Personal Homelab</h1>

            <div class="homelab-section">
                <h2 class="homelab-subtitle">Services</h2>

                <div class="homelab-list-container">
                    <ul class="homelab-list">
                        {services.map((service) => (
                            <li>
                                <a
                                    class="homelab-link"
                                    target="_blank"
                                    href={service.link}
                                >
                                    {service.name}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>

                <p class="homelab-description">
                    All of this runs on a single node Proxmox server with most
                    of the services being docker images running on a VM (Debian
                    & Fedora)
                </p>
                <p class="homelab-description">
                    Services that are images themselves like Home Assistant OS
                    are mounted directly to a Proxmox VM disk
                </p>
                <p class="homelab-description">
                    Backups happen every night to an offsite server which runs
                    Proxmox Backup Server connected via Tailscale controlled
                    with my Headscale control plane
                </p>
                <small>
                    Offsite server location is at my Grandfather's house in my
                    old room
                </small>
                <p class="homelab-description">
                    Their is an issue such that if Headscale is not up and
                    running I cannot access the server but for security reasons
                    I am okay with this
                </p>

                <h2 class="homelab-subtitle homelab-subtitle-center">
                    Server Hardware
                </h2>

                <div
                    id="homelab-hardware-table"
                    class="homelab-table-container"
                >
                    <table class="homelab-table">
                        <thead>
                            <tr>
                                <th class="homelab-table-header">Name</th>
                                <th class="homelab-table-header">Component</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="homelab-table-row">
                                <td class="homelab-table-cell">
                                    ASUS Z790-V Prime AX
                                </td>
                                <td class="homelab-table-cell">Motherboard</td>
                            </tr>
                            <tr class="homelab-table-row">
                                <td class="homelab-table-cell">
                                    Intel Core i5-12400 (6-Core/12-Thread)
                                </td>
                                <td class="homelab-table-cell">CPU</td>
                            </tr>
                            <tr class="homelab-table-row">
                                <td class="homelab-table-cell">
                                    Corsair Vengeance DDR5 6000mhz
                                    (128GB@4000mhz)
                                </td>
                                <td class="homelab-table-cell">RAM</td>
                            </tr>
                            <tr class="homelab-table-row">
                                <td class="homelab-table-cell">
                                    Samsung 970 EVO Plus (2TB)
                                </td>
                                <td class="homelab-table-cell">Boot Drive</td>
                            </tr>
                            <tr class="homelab-table-row">
                                <td class="homelab-table-cell">
                                    SATA Solid State Drive (1TB)
                                </td>
                                <td class="homelab-table-cell">SSD</td>
                            </tr>
                            <tr class="homelab-table-row">
                                <td class="homelab-table-cell">
                                    Hard Drive (2TB)
                                </td>
                                <td class="homelab-table-cell">HDD</td>
                            </tr>
                            <tr class="homelab-table-row">
                                <td class="homelab-table-cell">
                                    Hard Drive (1TB)
                                </td>
                                <td class="homelab-table-cell">HDD</td>
                            </tr>
                            <tr class="homelab-table-row">
                                <td class="homelab-table-cell">
                                    Hard Drive (1TB)
                                </td>
                                <td class="homelab-table-cell">HDD</td>
                            </tr>
                            <tr class="homelab-table-row">
                                <td class="homelab-table-cell">
                                    Corsair RM750 750 Watt 80 Plus Gold
                                </td>
                                <td class="homelab-table-cell">PSU</td>
                            </tr>
                            <tr class="homelab-table-row">
                                <td class="homelab-table-cell">
                                    NVIDIA 4070 Ti Super
                                </td>
                                <td class="homelab-table-cell">GPU (AI)</td>
                            </tr>
                            <tr class="homelab-table-row">
                                <td class="homelab-table-cell">
                                    Dresden Elektronik Phoscon ConBee 3
                                </td>
                                <td class="homelab-table-cell">
                                    Zigbee Controller
                                </td>
                            </tr>
                            <tr class="homelab-table-row">
                                <td class="homelab-table-cell">
                                    Zooz ZST39 LR
                                </td>
                                <td class="homelab-table-cell">
                                    Z-Wave Controller
                                </td>
                            </tr>
                            <tr class="homelab-table-row">
                                <td class="homelab-table-cell">
                                    Cyberpower SL700U
                                </td>
                                <td class="homelab-table-cell">Standby UPS</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <h2 class="homelab-subtitle homelab-subtitle-center">
                    Backup Server Hardware
                </h2>
                <div id="homelab-backup-table" class="homelab-table-container">
                    <table class="homelab-table">
                        <thead>
                            <tr>
                                <th class="homelab-table-header">Name</th>
                                <th class="homelab-table-header">Component</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="homelab-table-row">
                                <td class="homelab-table-cell">
                                    ASUS Prime B365M-A
                                </td>
                                <td class="homelab-table-cell">Motherboard</td>
                            </tr>
                            <tr class="homelab-table-row">
                                <td class="homelab-table-cell">Intel 7400</td>
                                <td class="homelab-table-cell">CPU</td>
                            </tr>
                            <tr class="homelab-table-row">
                                <td class="homelab-table-cell">
                                    Corsair Vengeance LPX (32GB DDR4@3200mhz)
                                </td>
                                <td class="homelab-table-cell">RAM</td>
                            </tr>
                            <tr class="homelab-table-row">
                                <td class="homelab-table-cell">
                                    WD Black 1TB NVME M.2 SSD
                                </td>
                                <td class="homelab-table-cell">Boot Drive</td>
                            </tr>
                            <tr class="homelab-table-row">
                                <td class="homelab-table-cell">
                                    Seagate 3.5" 5400RPM 8TB HDD
                                </td>
                                <td class="homelab-table-cell">Mass Storage</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <a class="homelab-back-button" href="/">
                    Back
                </a>
            </div>
        </div>
    </div>
</Layout>

<style>
    .homelab-container {
        max-width: 48rem; /* max-w-3xl */
        margin-left: auto;
        margin-right: auto;
        padding-left: 1rem; /* px-4 */
        padding-right: 1rem; /* px-4 */
        padding-top: 2rem; /* py-8 */
        padding-bottom: 2rem; /* py-8 */
    }

    .homelab-title {
        text-align: center;
        padding: 0.5rem;
        margin: 1rem;
        font-size: 1.5rem; /* text-2xl */
        line-height: 2rem;
        font-weight: 700; /* font-bold */
    }

    .homelab-section {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .homelab-subtitle {
        padding: 0.5rem; /* p-2 */
        font-weight: 700; /* font-bold */
        font-size: 1.25rem; /* text-xl */
        line-height: 1.75rem;
        margin-top: 2rem; /* mt-8 */
    }

    .homelab-subtitle-center {
        text-align: center;
    }

    .homelab-list {
        columns: 2;
        column-fill: balance;
        margin: 1.25rem; /* m-5 */
        list-style-type: disc;
        list-style-position: outside;
    }

    .homelab-list li {
        margin-bottom: 0.5rem; /* space-y-2 */
    }

    .homelab-link {
        color: #3b82f6; /* text-blue-500 */
    }

    .homelab-link:hover {
        text-decoration: underline;
    }

    @media (prefers-color-scheme: dark) {
        .homelab-link {
            color: #93c5fd; /* dark:text-blue-300 */
        }
    }

    .homelab-description {
        text-align: left;
        margin: 0.5rem;
        padding: 0.5rem; /* p-2 */
        max-width: 36rem; /* max-w-xl */
        letter-spacing: 0.025em; /* tracking-wide */
    }

    .homelab-table-container {
        display: flex;
        flex-direction: column;
        margin: 0.5rem; /* m-2 */
        padding: 0.5rem; /* p-2 */
    }

    .homelab-table {
        table-layout: auto;
        width: 100%; /* w-full */
        border-collapse: collapse;
    }

    .homelab-table-header {
        border-width: 1px;
        border-color: #e5e7eb; /* default border-gray-200 */
        padding: 0.5rem; /* p-2 */
        text-align: left;
    }

    .homelab-table-cell {
        border-width: 1px;
        border-color: #e5e7eb; /* default border-gray-200 */
        padding: 0.5rem; /* p-2 */
    }

    .homelab-table-row:nth-child(even) {
        background-color: #f5f5f5; /* even:bg-neutral-100 */
    }
    .homelab-list-container {
        display: flex;
        flex-direction: row;
    }

    @media (prefers-color-scheme: dark) {
        .homelab-table-row:nth-child(even) {
            background-color: #3f3f46; /* dark:even:bg-zinc-800 */
        }
    }

    .homelab-table-row:nth-child(odd) {
        background-color: #e5e5e5; /* odd:bg-neutral-200 */
    }

    @media (prefers-color-scheme: dark) {
        .homelab-table-row:nth-child(odd) {
            background-color: #27272a; /* dark:odd:bg-zinc-900 */
        }
    }

    .homelab-back-button {
        display: inline-block;
        background-color: #3b82f6; /* bg-blue-500 */
        color: #ffffff; /* text-white */
        font-weight: 700; /* font-bold */
        padding-top: 0.5rem; /* py-2 */
        padding-bottom: 0.5rem; /* py-2 */
        padding-left: 1rem; /* px-4 */
        padding-right: 1rem; /* px-4 */
        border-radius: 0.25rem; /* rounded */
        transition: all 0.3s ease-in-out; /* transition duration-300 ease-in-out */
        margin-top: 2rem; /* mt-8 */
        margin-bottom: 1rem; /* mb-4 */
        text-decoration: none;
    }

    .homelab-back-button:hover {
        background-color: #1d4ed8; /* hover:bg-blue-700 */
    }
</style>
